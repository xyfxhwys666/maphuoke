# SQLite is the default local database.
DATABASE_URL=sqlite+pysqlite:///./mapsearch.db

# Optional Amap Place Text API fallback. Keep empty to use Chrome web search only.
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_MAX_PAGES=3
AMAP_REQUEST_INTERVAL_SECONDS=0.3
AMAP_RETRY_LIMIT=3

# Dedicated browser/CDP settings. Profiles are isolated from daily Chrome data.
MAPSEARCH_AMAP_CDP_PORT=9227
MAPSEARCH_DOUBAO_CDP_PORT=9228
MAPSEARCH_CHROME_PATH=
DOUBAO_URL=https://www.doubao.com/chat/

# Batch guardrails.
MAPSEARCH_BATCH_MAX_ITEMS=1000
MAPSEARCH_BATCH_REQUEST_INTERVAL_SECONDS=0.3

# Optional ERP HTTP adapter. Automatic delivery remains off in task defaults.
ERP_URL=
ERP_BEARER_TOKEN=

# Optional OpenAI-compatible candidate relevance judge. Never commit the key.
KUAI_API_BASE_URL=https://api.kuai.host/v1
KUAI_API_KEY=
KUAI_MODEL=gpt-5.6-terra
